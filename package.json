{
  "name": "repo-map",
  "version": "0.1.2",
  "description": "A local universe of files, classes and imports",
  "author": "/home/whydoyousee",
  "homepage": "https://github.com/whydoyouseegit",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win zip --x64",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:mac": "electron-builder --mac zip",
    "postinstall": "node node_modules/electron/install.js",
    "build:win:signed": "electron-builder --win zip --x64 --config.forceCodeSigning=true",
    "verify:win": "node scripts/verify-windows.cjs",
    "checksums": "node scripts/checksums.cjs"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "resedit": "1.7.2"
  },
  "build": {
    "appId": "dev.whydoyousee.repomap",
    "productName": "Repo Map",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "zip",
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "Repo-Map-${version}-Windows-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png",
      "category": "Development"
    },
    "mac": {
      "target": "zip",
      "icon": "src/assets/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "afterSign": "scripts/verify-windows.cjs",
    "extraResources": [
      {
        "from": "src/assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "src/assets/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whydoyouseegit/repomap.git"
  }
}
