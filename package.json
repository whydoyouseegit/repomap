{
  "name": "repo-map",
  "version": "0.1.3",
  "description": "Local 3D code explorer for files, classes, functions and dependencies",
  "author": "/home/whydoyousee",
  "homepage": "https://github.com/whydoyouseegit/repomap",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:mac": "electron-builder --mac zip",
    "postinstall": "node node_modules/electron/install.js",
    "build:win:signed": "electron-builder --win nsis --x64 --config.forceCodeSigning=true --publish never",
    "verify:win": "node scripts/verify-windows.cjs",
    "checksums": "node scripts/checksums.cjs",
    "pack:source": "node scripts/pack-source.cjs"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "resedit": "1.7.2"
  },
  "build": {
    "appId": "dev.whydoyousee.repomap",
    "productName": "Repo Map",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png",
      "category": "Development"
    },
    "mac": {
      "target": "zip",
      "icon": "src/assets/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "afterSign": "scripts/verify-windows.cjs",
    "extraResources": [
      {
        "from": "src/assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "src/assets/icon.png",
        "to": "icon.png"
      }
    ],
    "nsis": {
      "artifactName": "Repo-Map-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Repo Map",
      "uninstallDisplayName": "Repo Map",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whydoyouseegit/repomap.git"
  }
}
